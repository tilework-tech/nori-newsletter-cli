{
  "name": "nori-newsletter-cli",
  "version": "1.0.0",
  "description": "CLI for managing and sending newsletters via AWS SES",
  "type": "module",
  "bin": {
    "nori-newsletter": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "newsletter",
    "ses",
    "cli",
    "email",
    "aws"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilework-tech/nori-newsletter-cli.git"
  },
  "homepage": "https://github.com/tilework-tech/nori-newsletter-cli#readme",
  "bugs": {
    "url": "https://github.com/tilework-tech/nori-newsletter-cli/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.800.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
